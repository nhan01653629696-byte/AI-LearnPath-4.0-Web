{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-learnpath-4-web",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "observability": {"enabled": true},
  "placement": {"region": "gcp:us-east4"},
  "durable_objects": {
    "bindings": [{"name": "LEARNPATH_DB", "class_name": "LearnPathDB"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["LearnPathDB"]}],
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "vars": {"GEMINI_MODEL": "gemini-3.8-flash"}
}
